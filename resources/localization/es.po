msgid "English"
msgstr "Español"

msgctxt "ui.menu.playNewGame"
msgid "Play new game"
msgstr "Jugar partida nueva"

msgctxt "ui.menu.buildMap"
msgid "Build a map"
msgstr "Construir un mapa"

#. Opens the list of languages, each named in its own language.
msgctxt "ui.menu.language"
msgid "Language"
msgstr "Idioma"

#. The header while the party explores, out of the battles.
msgctxt "ui.battleInfo.exploring"
msgid "Exploring"
msgstr "Explorando"

#. The header when a battle starts.
msgctxt "ui.battleInfo.battle"
msgid "Battle!"
msgstr "¡Batalla!"

#. The header when a battle finishes.
msgctxt "ui.battleInfo.battleOver"
msgid "Battle over!"
msgstr "¡Fin de la batalla!"

#. {round}: the number of the battle round, e.g.: 3.
msgctxt "ui.battleInfo.round"
msgid "Round {round}"
msgstr "Ronda {round}"

#. {player}: the name of the player whose turn it is.
msgctxt "ui.battleInfo.playerTurn"
msgid "{player} turn"
msgstr "Turno de {player}"

#. {player}: the name of the winning player.
msgctxt "ui.battleInfo.playerWins"
msgid "{player} wins!"
msgstr "¡{player} gana!"

#. How many turns a summon has left, the current one included. {turns}: the number of turns.
msgctxt "ui.remainingTurns.vanishes"
msgid "Vanishes in {turns} turn"
msgid_plural "Vanishes in {turns} turns"
msgstr[0] "Desaparece en {turns} turno"
msgstr[1] "Desaparece en {turns} turnos"

msgctxt "ui.finishTurn.finishTurn"
msgid "Finish turn"
msgstr "Terminar turno"

